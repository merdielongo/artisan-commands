@push('scripts')
<script>
$(document).ready(function() {
    $('#datatable').DataTable({
        processing: true,
        serverSide: true,
        ajax: '{{ route('{{ $routePrefix }}.datatable') }}',
        columns: [
            { data: 'id', name: 'id' },
            @foreach($tableColumns as $column)
            { 
                data: '{{ $column['name'] }}', 
                name: '{{ $column['name'] }}',
                @if($column['type'] === 'boolean')
                render: function(data) {
                    return data ? '<span class="text-green-600"><i class="fas fa-check"></i></span>' : 
                           '<span class="text-red-600"><i class="fas fa-times"></i></span>';
                }
                @endif
            },
            @endforeach
            { data: 'action', name: 'action', orderable: false, searchable: false }
        ]
    });
});
</script>
@endpush
